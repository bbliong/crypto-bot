{
  "name": "gmgn-websocket-monitor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "probe": "node scripts/run.mjs probe",
    "start": "node scripts/run.mjs start",
    "research": "node scripts/run.mjs research",
    "research:three-lanes": "node scripts/run.mjs research --strategy momentum-v2 --quoteSimulation --laneWorkers --workers 3 --seconds 1800 --stakeUsd 2",
    "monitor": "node scripts/run.mjs monitor",
    "research:flow3": "node scripts/run.mjs research --strategy flow-3",
    "research:pump-band": "node scripts/run.mjs pump-research",
    "momentum:replay": "node scripts/run.mjs momentum:replay",
    "execution:reconcile": "node scripts/reconcile-live-orders.mjs",
    "execution:delay-replay": "node scripts/replay-execution-delay.mjs",
    "holders:inspect": "node --import tsx scripts/inspect-gmgn-holders.ts",
    "holders:simulate-all": "node --import tsx scripts/simulate-all-gmgn-holders.ts",
    "holders:simulate-onchain-all": "node scripts/simulate-all-onchain-holders.mjs",
    "research:trial": "node scripts/run.mjs research --maxBuys 2",
    "capture:orders": "node scripts/run.mjs research --strategy momentum-v2 --workers 1 --maxPaperBuys 1 --stakeUsd 0.25 --orderCapture --orderCapturePayloads --controlOnly",
    "simulate:order": "node scripts/run.mjs research --strategy momentum-v2 --workers 1 --maxPaperBuys 1 --stakeUsd 0.25 --simulateOrder --controlOnly",
    "research:quote": "node scripts/run.mjs research --strategy momentum-v2 --quoteSimulation --controlOnly",
    "browser:buy": "node scripts/run.mjs research --strategy momentum-v2 --browserBuyPrompt --orderOutcomeCapture --controlOnly",
    "browser:buy:auto": "node scripts/run.mjs research --strategy momentum-v2 --seconds 0 --browserAutoTrade --orderOutcomeCapture --controlOnly",
    "browser:buy:test": "node scripts/run.mjs research --strategy momentum-v2 --workers 1 --maxPaperBuys 1 --stakeUsd 0.25 --browserBuyPrompt --browserPromptTestSignal --orderOutcomeCapture --controlOnly",
    "trade-ui": "node scripts/run.mjs trade-ui",
    "replay": "node scripts/run.mjs replay",
    "dashboard:data": "node scripts/run.mjs dashboard:data",
    "dashboard:serve": "node scripts/serve-dashboard.mjs",
    "test": "node scripts/run.mjs test",
    "typecheck": "node scripts/run.mjs typecheck"
  },
  "dependencies": {
    "playwright": "^1.55.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
