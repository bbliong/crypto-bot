{
  "manifest_version": 3,
  "name": "GMGN Existing Tab Listener",
  "version": "0.1.0",
  "minimum_chrome_version": "125",
  "description": "Listen to WebSocket frames in existing GMGN tabs; forward to your local monitor.",
  "permissions": [
    "debugger",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}